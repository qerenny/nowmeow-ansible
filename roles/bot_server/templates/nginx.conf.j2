user www-data;
worker_processes auto;

error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '[$time_local] $remote_addr - $remote_user "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;

    server {
        listen 80;
{% if bot_server_enable_ipv6 | bool %}
        listen [::]:80;
{% endif %}
        server_name {{ domain_name }};
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2;
{% if bot_server_enable_ipv6 | bool %}
        listen [::]:443 ssl http2;
{% endif %}
        server_name {{ domain_name }};

        ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers on;

        add_header Strict-Transport-Security "max-age=63072000" always;

        access_log /var/log/nginx/visiting-card-access.log main;

        location / {
            root {{ bot_server_site_root }}/;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        location {{ bot_server_primary_proxy_path }} {
            proxy_pass http://127.0.0.1:{{ bot_server_primary_proxy_port }};
            include /etc/nginx/proxy_params;
        }

        location {{ bot_server_secondary_proxy_path }} {
            proxy_pass http://127.0.0.1:{{ bot_server_secondary_proxy_port }};
            include /etc/nginx/proxy_params;
        }
    }
}
