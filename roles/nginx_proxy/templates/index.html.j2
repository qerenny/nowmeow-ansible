        function generateFact() {
            const factBox = document.getElementById('factDisplay');
            factBox.style.opacity = 0; // Плавное исчезновение
            
            setTimeout(() => {
                const randomIndex = Math.floor(Math.random() * facts.length);
                factBox.innerText = facts[randomIndex];
                factBox.style.opacity = 1; // Плавное появление
            }, 200);
        }
        
        // Показываем первый факт при загрузке страницы
        window.onload = generateFact;
