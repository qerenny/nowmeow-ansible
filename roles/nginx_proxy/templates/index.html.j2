<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meow Facts | Интересно о котах</title>
    <style>
        /* Цветовая палитра с картинки */
        :root {
            --bg-left: #42b2e8;       /* Голубой со щита */
            --bg-right: #e186a8;      /* Розовый со щита */
            --cat-face: #fcecf0;      /* Светлый цвет мордочки */
            --dark-navy: #1b2640;     /* Темно-синий контур */
            --blush-pink: #f29fb4;    /* Цвет щечек */
        }

        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            /* Градиентный фон как на фоне щита */
            background: linear-gradient(135deg, var(--bg-left) 0%, var(--bg-right) 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--dark-navy);
        }

        .container {
            background-color: var(--cat-face);
            border-radius: 24px;
            padding: 40px;
            max-width: 450px;
            width: 90%;
            /* Имитация контура как на рисунке */
            border: 5px solid var(--dark-navy);
            box-shadow: 0 15px 35px rgba(27, 38, 64, 0.2);
            text-align: center;
        }

        h1 {
            margin-top: 0;
            font-size: 26px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .fact-box {
            background-color: #ffffff;
            border: 3px dashed var(--blush-pink);
            border-radius: 16px;
            padding: 25px 20px;
            margin: 25px 0;
            font-size: 18px;
            font-weight: 500;
            line-height: 1.5;
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.3s ease;
        }

        button {
            background-color: var(--dark-navy);
            color: var(--cat-face);
            border: none;
            padding: 14px 28px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 0px rgba(0,0,0,0.2);
        }

        button:hover {
            background-color: var(--blush-pink);
            color: var(--dark-navy);
            transform: translateY(2px);
            box-shadow: 0 2px 0px rgba(0,0,0,0.2);
        }

        button:active {
            transform: translateY(4px);
            box-shadow: none;
        }
    </style>
</head>
